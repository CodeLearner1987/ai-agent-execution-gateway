# Copy this file to .env and fill in values as needed.
# If SUPABASE_URL and SUPABASE_KEY are both left unset, the gateway
# automatically falls back to local SQLite storage (data/gateway.db).

# --- SQLite (default, no config needed) ---
# GATEWAY_DB_PATH=data/gateway.db

# --- Supabase (optional) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-service-role-or-anon-key
# SUPABASE_TABLE=gateway_logs
